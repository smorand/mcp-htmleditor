# Production variables of the web library mode (SPEC-0025). Nothing secret lives here.
# Copy this file ONCE to /app/data/mcp-htmleditor/.env on the VPS (vps-deploy.sh copies environments/<env>/* and a
# glob skips dotfiles, so it does not travel by itself), then edit it there. The Google OAuth client file
# (/data/google-oauth.json in the container) is copied by hand to /app/data/mcp-htmleditor/google-oauth.json, mode 0600.
HTMLEDITOR_HOST=0.0.0.0
HTMLEDITOR_PORT=7842
HTMLEDITOR_LIBRARY_ORIGIN=https://slides.scm-platform.org
HTMLEDITOR_LIBRARY_CONTENT_ORIGIN=https://slides-content.scm-platform.org
HTMLEDITOR_LIBRARY_DIR=/data/library
HTMLEDITOR_STATE_DIR=/data/state
HTMLEDITOR_GOOGLE_CREDENTIALS_FILE=/data/google-oauth.json
# HTMLEDITOR_OTEL_DESTINATION=http://collector:4318/v1/traces
# HTMLEDITOR_OTEL_API_KEY=
