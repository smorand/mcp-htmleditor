# Environment variables for mcp-htmleditor
# Copy to .env and adjust values if needed. Every variable is read through the
# pydantic-settings Settings class (src/mcp_htmleditor/config.py).

# --- HTTP server ---------------------------------------------------------
# Bind address (use 0.0.0.0 in a container so the published port answers)
HTMLEDITOR_HOST=localhost
# HTTP port
HTMLEDITOR_PORT=7842
# Browser polling interval in milliseconds
HTMLEDITOR_POLL_INTERVAL=1000

# --- Paths ---------------------------------------------------------------
# Templates directory (default ~/.config/mcp-htmleditor/templates)
# HTMLEDITOR_TEMPLATES_DIR=/path/to/templates
# Cache directory (default ~/.cache/mcp-htmleditor)
# HTMLEDITOR_CACHE_DIR=/path/to/cache
# Log directory (default ~/.cache/mcp-htmleditor/logs); HTMLEDITOR_LOGS is an alias
# HTMLEDITOR_LOG_DIR=/path/to/logs
# CLI install target used by `make install` (default ~/.local/bin)
# HTMLEDITOR_BIN_DIR=/path/to/bin

# --- OpenTelemetry -------------------------------------------------------
# OTLP/HTTP endpoint; unset means JSONL spans in <log dir>/mcp-htmleditor-otel.log
# HTMLEDITOR_OTEL_DESTINATION=http://localhost:4318/v1/traces
# Sent as `Authorization: Bearer <key>` on every OTLP export
# HTMLEDITOR_OTEL_API_KEY=change-me
